# Backend (apps/api) — copiá a .env y ajustá. Nunca commitees .env.

# Entorno
MINDFUL_ENV=development

# Base de datos (Postgres local del docker-compose)
MINDFUL_DATABASE_URL=postgresql+psycopg://mindful:mindful@127.0.0.1:5432/mindful

# Auth: dev = sin token (local) | firebase = valida Firebase ID token
MINDFUL_AUTH_MODE=dev
# Requerido cuando AUTH_MODE=firebase (Cloud Run lo setea solo)
MINDFUL_GOOGLE_CLOUD_PROJECT=

# CORS para el front Expo (PWA dev server)
MINDFUL_CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081
